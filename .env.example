# Flutter build-time configuration. Copy to .env and run:
#   flutter run --dart-define-from-file=.env
# These values are compiled into the app and readable by anyone with the binary: never put
# real secrets here.

# "backend" = AWS API Gateway, "demo" = talk straight to dawem-ai.
# Unset: backend when API_BASE_URL is set, otherwise demo.
API_MODE=demo

# Backend mode: the ApiUrl output of the CDK stack.
API_BASE_URL=

# Demo mode: dawem-ai. Android emulator: http://10.0.2.2:8000
AI_BASE_URL=http://localhost:8000
# Demo mode only, and only if dawem-ai has DAWEM_AI_API_KEY set.
AI_API_KEY=
DEMO_USER_ID=demo-user

# Backend mode: IANA timezone saved in the profile (decides what "today" means) and a Cognito token
# for development until sign-in is wired to Cognito.
TIMEZONE=UTC
DEV_AUTH_TOKEN=
